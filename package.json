{
  "name": "playable-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Studio for playable ads: releases, variants, live preview and ad-network exports.",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=server --watch-path=shared server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "sync-kit": "node scripts/sync-kit.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "format": "prettier --write \"{server,web,scripts,tests}/**/*.{js,jsx,css}\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fastify/middie": "^9.3.4",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.9",
    "vite": "^7.3.6"
  }
}
